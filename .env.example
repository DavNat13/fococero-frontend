# ==========================================
# 🌐 CONEXIÓN AL BACKEND (BFF)
EXPO_PUBLIC_API_GATEWAY_URL=http://localhost:3000
EXPO_PUBLIC_ENVIRONMENT=development
# ==========================================
# 🔥 FIREBASE WEB SDK (Para Google Auth en Expo Go)
# Solo variables públicas, NINGUNA llave privada aquí.
# ==========================================
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID="1:your-project:web:your-web-id"
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# ==========================================
# 🔐 SEGURIDAD (Zero-Trust)
# ==========================================
EXPO_PUBLIC_INTERNAL_TOKEN=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# ==========================================
# ⏱️ RESILIENCIA
# ==========================================
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_OFFLINE_SYNC_INTERVAL=30000
# ==========================================
# 👁️ OBSERVABILIDAD
# ==========================================
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_LOG_LEVEL=debug
