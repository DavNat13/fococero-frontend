// c:/Users/David/Desktop/FocoCero/fococero-frontend/app.json

{
  "expo": {
    "name": "FocoCero",
    "slug": "fococero-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fococero",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D9480F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valledelsol.fococero",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FocoCero necesita tu ubicación para reportar incendios cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FocoCero requiere seguimiento GPS para la seguridad de los brigadistas en terreno.",
        "NSLocationAlwaysUsageDescription": "Necesitamos acceso permanente para coordinar la respuesta ante incendios.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.valledelsol.fococero",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D9480F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permitir que FocoCero rastree tu ubicación para coordinación de brigadas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
