{
  "expo": {
    "name": "FocoCero",
    "slug": "fococero-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fococero",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D9480F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valledelsol.fococero",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FocoCero necesita tu ubicación para reportar incendios cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FocoCero requiere seguimiento GPS para la seguridad de los brigadistas en terreno.",
        "NSLocationAlwaysUsageDescription": "Necesitamos acceso permanente para coordinar la respuesta ante incendios.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "location",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.valledelsol.fococero",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#D9480F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permitir que FocoCero rastree tu ubicación para coordinación de brigadas."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "247babcd-3833-4157-89d9-16523e76c921"
      }
    }
  }
}
